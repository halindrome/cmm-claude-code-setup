# VBW internal planning directory — not relevant to users of this repo

# Local Claude Code configuration (installed hooks, local settings, session state)
# Source hooks live in hooks/project/ — .claude/ is the local installation target
.claude/*

# MCP server registration — local/per-machine artifact (managed by setup.sh,
# contains machine-specific paths). Not shared.
/.mcp.json

# macOS
.DS_Store

# Editor
.idea/
*.swp

# Benchmark results (actual runs) — keep examples and templates
benchmarks/results/raw-*.csv
benchmarks/results/aggregated-*.csv
benchmarks/results/REPORT-*.md
!benchmarks/results/REPORT-TEMPLATE.md

# CMM-generated session artifacts
.codebase-memory/

# Node.js v8 compile cache
node-compile-cache/

# Python bytecode (scripts/*.py are run directly, never packaged)
__pycache__/
*.pyc
