{
  "_comment": "Upstream context-mode hooks (PostToolUse/PreToolUse/PreCompact/SessionStart/UserPromptSubmit with command 'context-mode hook claude-code <event>') are merged separately by merge_context_mode_hooks() in setup.sh, guarded by INSTALL_CONTEXT_MODE=true. Do NOT add them here or the basename-based dedup in merge_settings_json will collide with the substring-based dedup in merge_context_mode_hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-gate.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/agent-cmm-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ctx-execute-enforcer.sh",
            "_comment": "Blocks raw Bash commands that produce large output; redirects to ctx_execute (no-ops if Context Mode not installed)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cwd-guard.sh",
            "_comment": "Blocks persistent 'cd' away from the project root to prevent shell cwd drift (which breaks sentinel-hash matching in monorepos/submodules); allows absolute paths, git -C, subshells, and re-anchoring to root. Bypass with '# cwd-exempt'."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-nudge.sh",
            "_comment": "Blocks Read on code files; redirects to CMM graph tools (no-ops if CMM not installed)"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-grep-nudge.sh",
            "_comment": "Blocks Grep on code files; redirects to CMM graph tools (no-ops if CMM not installed)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-grep-nudge.sh",
            "_comment": "Blocks Bash grep/find/cat navigation against source paths; redirects to CMM tools (no-ops if CMM not indexed)"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/grep-cmm-gate.sh",
            "_comment": "Hard-blocks Grep on indexed source code with machine-readable REPLACE WITH advisory (no-ops if CMM not installed)"
          }
        ]
      },
      {
        "matcher": "mcp__context-mode__ctx_execute",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ctx-execute-cmm-nudge.sh",
            "_comment": "Hard-blocks ctx_execute(code=\"grep/rg/find ... src/\") on indexed source code; redirects to CMM (no-ops if CMM not installed)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__codebase-memory-mcp__index_repository|mcp__codebase-memory-mcp__index_status",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-sentinel-writer.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_context-mode_context-mode__ctx_execute|mcp__plugin_context-mode_context-mode__ctx_stats|mcp__plugin_context-mode_context-mode__ctx_index|mcp__plugin_context-mode_context-mode__ctx_fetch_and_index|mcp__plugin_context-mode_context-mode__ctx_batch_execute|mcp__plugin_context-mode_context-mode__ctx_execute_file|mcp__plugin_context-mode_context-mode__ctx_search|mcp__context-mode__ctx_execute|mcp__context-mode__ctx_stats|mcp__context-mode__ctx_index|mcp__context-mode__ctx_fetch_and_index|mcp__context-mode__ctx_batch_execute|mcp__context-mode__ctx_execute_file|mcp__context-mode__ctx_search",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-mode-sentinel-writer.sh",
            "_comment": "Writes Context Mode sentinel to unblock ctx-execute-enforcer. Matches both plugin form (mcp__plugin_context-mode_context-mode__*) and legacy MCP-server form (mcp__context-mode__*)."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/reindex-after-commit.sh",
            "_comment": "Marks CMM sentinel stale after git commit, unless running in VBW team mode"
          }
        ]
      },
      {
        "matcher": "mcp__codebase-memory-mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/track-cmm-calls.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_context-mode_context-mode__*|mcp__context-mode__*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/track-ctx-calls.sh"
          }
        ]
      },
      {
        "matcher": "mcp__codebase-memory-mcp__search_graph|mcp__codebase-memory-mcp__get_code_snippet|mcp__codebase-memory-mcp__trace_path|mcp__codebase-memory-mcp__query_graph",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-query-stale-advisory.sh",
            "_comment": "Prints advisory to stderr if CMM index is stale after recent commit"
          }
        ]
      },
      {
        "matcher": "mcp__codebase-memory-mcp__search_graph",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-orient-nudge.sh",
            "_comment": "One-shot-per-session PostToolUse nudge after first search_graph call \u2014 suggests get_architecture/trace_path/query_graph (no-ops if CMM not installed)"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-cmm-startup.sh",
            "_comment": "Injects CMM index state into all subagents via additionalContext JSON at startup"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-ctx-startup.sh",
            "_comment": "Injects a ctx_stats nudge into subagents via additionalContext JSON at startup (no-ops if Context Mode not installed)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/user-prompt-submit-skill-nudge.sh",
            "_comment": "Injects cmm-rules + ctx-rules skill activation on code-navigation prompts (find, trace, grep, etc.)"
          }
        ]
      }
    ]
  }
}
