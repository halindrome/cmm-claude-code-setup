{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-gate.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/agent-cmm-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ctx-execute-enforcer.sh",
            "_comment": "Blocks raw Bash commands that produce large output; redirects to ctx_execute (no-ops if Context Mode not installed)"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-nudge.sh",
            "_comment": "Blocks Read on code files; redirects to CMM graph tools (no-ops if CMM not installed)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__codebase-memory-mcp__index_repository|mcp__codebase-memory-mcp__index_status",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-sentinel-writer.sh"
          }
        ]
      },
      {
        "matcher": "mcp__context-mode__ctx_execute|mcp__context-mode__ctx_stats|mcp__context-mode__ctx_index|mcp__context-mode__ctx_fetch_and_index|mcp__context-mode__ctx_batch_execute|mcp__context-mode__ctx_execute_file|mcp__context-mode__ctx_search",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-mode-sentinel-writer.sh",
            "_comment": "optional: writes Context Mode sentinel to unblock session-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/reindex-after-commit.sh",
            "_comment": "Marks CMM sentinel stale after git commit, unless running in VBW team mode"
          }
        ]
      },
      {
        "matcher": "mcp__codebase-memory-mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/track-cmm-calls.sh"
          }
        ]
      },
      {
        "matcher": "mcp__context-mode__*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/track-ctx-calls.sh"
          }
        ]
      },
      {
        "matcher": "mcp__codebase-memory-mcp__search_graph|mcp__codebase-memory-mcp__get_code_snippet|mcp__codebase-memory-mcp__trace_call_path|mcp__codebase-memory-mcp__query_graph",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cmm-query-stale-advisory.sh",
            "_comment": "Prints advisory to stderr if CMM index is stale after recent commit"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-mode-event-logger.sh",
            "_comment": "optional: Context Mode MCP event logger (no-ops if Context Mode not installed)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-mode-pre-compact.sh",
            "_comment": "optional: Context Mode MCP pre-compaction snapshot (no-ops if not installed)"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-cmm-startup.sh",
            "_comment": "Injects CMM index state into all subagents via additionalContext JSON at startup"
          }
        ]
      }
    ]
  }
}
